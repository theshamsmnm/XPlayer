<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background is black to avoid a white flash before Compose draws (AMOLED default). -->
    <style name="Theme.XPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/xplayer_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
